# %% [code]
def pianoroll_to_midi(pianoroll, fs=FS, threshold=GEN_THRESHOLD, velocity=80):
    midi = pretty_midi.PrettyMIDI(initial_tempo=120.0)
    piano = pretty_midi.Instrument(program=0, name='Piano')
    binary = (pianoroll >= threshold).astype(int)

    for pitch_idx in range(NUM_PITCHES):
        pitch = pitch_idx + PITCH_START
        note_on = False
        start_time = 0.0
        for t in range(binary.shape[0]):
            if binary[t, pitch_idx] == 1 and not note_on:
                note_on = True
                start_time = t / fs
            elif binary[t, pitch_idx] == 0 and note_on:
                note_on = False
                end_time = t / fs
                if end_time - start_time > 0.001:
                    note = pretty_midi.Note(velocity=velocity, pitch=pitch,
                                            start=start_time, end=end_time)
                    piano.notes.append(note)
        if note_on:
            end_time = binary.shape[0] / fs
            note = pretty_midi.Note(velocity=velocity, pitch=pitch,
                                    start=start_time, end=end_time)
            piano.notes.append(note)
    midi.instruments.append(piano)
    return midi

print("\n" + "=" * 60)

# ## 3. Preprocessing Pipeline
#
# We need to process two datasets:
# - MAESTRO (classical piano) → provides classical genre
# - Lakh MIDI Clean (pop/rock/jazz/R&B) → provides multi-genre diversity

# %% [code]
def midi_to_pianoroll_windows(midi_path, fs=FS, window_len=WINDOW_LEN, min_active_ratio=MIN_ACTIVE_RATIO):
    """Convert MIDI to list of piano-roll windows."""
    try:
        midi = pretty_midi.PrettyMIDI(midi_path)
        piano_roll = midi.get_piano_roll(fs=fs)[PITCH_START:PITCH_END+1, :].T
        piano_roll = (piano_roll > 0).astype(np.float32)

        T_total = piano_roll.shape[0]
        windows = []
        for start in range(0, T_total - window_len + 1, window_len):
            win = piano_roll[start:start+window_len, :]
            if np.mean(win) >= min_active_ratio:
                windows.append(win)
        return windows
    except Exception as e:
        return []

def preprocess_maestro_split(df_split, split_name):
    """Process MAESTRO split and return windows with genre label."""
    out_file = f"pianoroll_maestro_{split_name}.npy"
    genre_file = f"genres_maestro_{split_name}.npy"

    if os.path.exists(out_file) and os.path.exists(genre_file):
        print(f"Loading existing {out_file}")
        return np.load(out_file), np.load(genre_file)

    all_windows = []
    all_genres = []

    for _, row in tqdm(df_split.iterrows(), total=len(df_split), desc=f"MAESTRO {split_name}"):
        midi_path = os.path.join(MAESTRO_ROOT, row['midi_filename'])
        windows = midi_to_pianoroll_windows(midi_path)
        if windows:
           
            genre = row.get('composer', 'Unknown')
            all_windows.extend(windows)
            all_genres.extend([genre] * len(windows))

    data = np.stack(all_windows, axis=0)
    genres = np.array(all_genres)
    np.save(out_file, data)
    np.save(genre_file, genres)
    print(f"Saved {split_name}: {data.shape}")
    return data, genres

def preprocess_lakh_dataset(sample_size=5000):
    """Process Lakh MIDI Clean dataset - sample from different artist folders."""
    out_file = "pianoroll_lakh.npy"
    genre_file = "genres_lakh.npy"

    if os.path.exists(out_file) and os.path.exists(genre_file):
        print(f"Loading existing {out_file}")
        return np.load(out_file), np.load(genre_file)

    # MIDI files from Lakh dataset
    midi_files = glob.glob(os.path.join(LAKH_ROOT, "*/*.mid")) + glob.glob(os.path.join(LAKH_ROOT, "*.mid"))
    print(f"Found {len(midi_files)} MIDI files in Lakh dataset")


    if sample_size and len(midi_files) > sample_size:
        midi_files = random.sample(midi_files, sample_size)

    all_windows = []
    all_genres = []

    for path in tqdm(midi_files, desc="Processing Lakh"):
        # Extract genre from artist folder name
        artist = os.path.basename(os.path.dirname(path))
        if not artist or artist == '.':
            artist = 'Unknown'

        # Assign broad genre categories
        genre_map = {
            'Beethoven': 'Classical', 'Mozart': 'Classical', 'Bach': 'Classical',
            'Miles_Davis': 'Jazz', 'John_Coltrane': 'Jazz', 'Duke_Ellington': 'Jazz',
            'Beatles': 'Rock', 'Rolling_Stones': 'Rock', 'Queen': 'Rock',
            'Michael_Jackson': 'Pop', 'Madonna': 'Pop', 'Prince': 'Pop',
            'Aretha_Franklin': 'R&B', 'Stevie_Wonder': 'R&B'
        }

        genre = genre_map.get(artist.replace('_', ' ').split()[0], 'Popular')

        windows = midi_to_pianoroll_windows(path)
        if windows:
            all_windows.extend(windows)
            all_genres.extend([genre] * len(windows))

    if not all_windows:
        raise RuntimeError("No windows generated from Lakh dataset")

    data = np.stack(all_windows, axis=0)[:20000]  # Limit total
    genres = np.array(all_genres)[:20000]
    np.save(out_file, data)
    np.save(genre_file, genres)
    print(f"Saved Lakh data: {data.shape}")
    return data, genres


def rhythm_diversity(midi_obj):
    durations = []
    for inst in midi_obj.instruments:
        for note in inst.notes:
            durations.append(note.end - note.start)
    if not durations:
        return 0.0
    unique = len(set(durations))
    total = len(durations)
    return unique / total if total > 0 else 0.0


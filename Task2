# ## 8. Latent Interpolation Between Two Genres
#
# We encode two real pieces from different genres (e.g., Classical and Rock) and interpolate their latent vectors.

# %% [code]
def get_latent_for_genre(genre_name, dataset, model, device, num_samples=1):
    """Return mu vector for a random window of given genre."""
    indices = [i for i, g in enumerate(dataset.genres) if genre_name.lower() in g.lower()]
    if not indices:
      
        indices = [i for i, g in enumerate(dataset.genres) if any(word in g.lower() for word in genre_name.lower().split())]
    if not indices:
        # Fallback
        indices = list(range(len(dataset.genres)))[:100]
    idx = random.choice(indices)
    x = dataset.windows[idx].unsqueeze(0).to(device)
    with torch.no_grad():
        mu, _ = model.encoder(x)
    return mu.squeeze().cpu().numpy()

# Get available genres from training data
available_genres = list(set(train_genres))
print(f"Available genres: {available_genres[:10]}")
print(f"Total unique genres: {len(set(train_genres))}")

# Select two distinct genres for interpolation
genre1 = 'Classical' if 'Classical' in available_genres else available_genres[0]
genre2 = 'Rock' if 'Rock' in available_genres else available_genres[-1]
print(f"Interpolating between: {genre1} → {genre2}")

mu1 = get_latent_for_genre(genre1, train_dataset, model, device)
mu2 = get_latent_for_genre(genre2, train_dataset, model, device)

alphas = np.linspace(0, 1, INTERP_STEPS)
print("\nGenerating interpolation MIDI files...")

with torch.no_grad():
    for idx, alpha in enumerate(alphas):
        z = (1 - alpha) * mu1 + alpha * mu2
        z_tensor = torch.from_numpy(z).float().unsqueeze(0).to(device)
        recon_logits = model.decoder(z_tensor)
        recon_probs = torch.sigmoid(recon_logits).cpu().numpy()[0]
        recon_probs = np.clip(recon_probs * 2.0, 0, 1)
        midi_obj = pianoroll_to_midi(recon_probs, threshold=GEN_THRESHOLD)
        out_path = f"interpolation_midi/interp_{genre1}_{genre2}_alpha_{alpha:.2f}.mid"
        midi_obj.write(out_path)
        print(f"  Alpha={alpha:.2f}: {out_path}")

print(f"\nSaved {INTERP_STEPS} interpolation MIDIs to interpolation_midi/")


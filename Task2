if TRAINED:
    for epoch in range(1, EPOCHS + 1):
        beta = min(1.0, epoch / KL_WARMUP_EPOCHS)
        kl_weights.append(beta)

        # Training
        model.train()
        epoch_recon_loss = 0.0
        epoch_kl_loss = 0.0
        epoch_total_loss = 0.0

        for batch in train_loader:

with torch.no_grad():
    for i in range(NUM_GEN_SAMPLES):
        z = torch.randn(1, LATENT_DIM).to(device)
        recon_logits = model.decoder(z)
        recon_probs = torch.sigmoid(recon_logits).cpu().numpy()[0]
       
        recon_probs = np.clip(recon_probs * 2.0, 0, 1)
        print(f"Sample {i+1}: scaled max prob = {recon_probs.max():.4f}, mean = {recon_probs.mean():.4f}")
        midi_obj = pianoroll_to_midi(recon_probs, threshold=GEN_THRESHOLD)
        out_path = f"generated_midi_task2/vae_sample_{i+1}.mid"
        midi_obj.write(out_path)
        print(f"  Saved: {out_path}")


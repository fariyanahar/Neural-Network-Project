            optimizer.zero_grad()
            recon_logits, mu, logvar, _ = model(x)
            recon_loss = recon_criterion(recon_logits, x)
            kl_loss = kl_divergence(mu, logvar)
            loss = recon_loss + beta * kl_loss
            loss.backward()
            optimizer.step()

            epoch_recon_loss += recon_loss.item() * x.size(0)
            epoch_kl_loss += kl_loss.item() * x.size(0)
            epoch_total_loss += loss.item() * x.size(0)

